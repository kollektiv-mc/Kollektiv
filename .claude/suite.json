{
  "product": "kollektiv",
  "kind": "workspace-root",
  "tracking": "github-issues",
  "roadmap": "docs/roadmap.md",
  "health": {
    "commands": [
      {
        "name": "script syntax",
        "run": "for f in scripts/*.sh scripts/lib/*.sh; do bash -n \"$f\" || exit 1; done"
      },
      {
        "name": "manifests",
        "run": "./scripts/check-manifests.sh"
      },
      {
        "name": "schema validation",
        "run": "./scripts/validate-schemas.sh"
      },
      {
        "name": "release notes",
        "run": "python3 plugins/suite-kit/release-notes_test.py"
      },
      {
        "name": "participation",
        "run": "./scripts/check-participation.sh"
      },
      {
        "name": "priority field",
        "run": "./scripts/sync-priority.sh --check"
      }
    ]
  }
}
