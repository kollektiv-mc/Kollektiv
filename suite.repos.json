{
  "suite": "kollektiv",
  "tracking": "github-issues",
  "linear": {
    "workspace": "Kollektiv-MC",
    "role": "downstream mirror, written only by the GitHub → Linear sync routine"
  },
  "tokens": {
    "source": "design/tokens.json",
    "vendoredAs": "tokens.source.json"
  },
  "repos": [
    {
      "name": "Konnekt",
      "url": "https://github.com/kollektiv-mc/Konnekt.git",
      "kind": "wails-desktop",
      "roadmap": "agent_docs/ROADMAP.md",
      "tokens": {
        "role": "consumer",
        "generate": "pnpm gen:tokens"
      }
    },
    {
      "name": "Kommands",
      "url": "https://github.com/kollektiv-mc/Kommands.git",
      "kind": "vite-web",
      "roadmap": "docs/roadmap.md",
      "tokens": {
        "role": "consumer",
        "generate": "pnpm gen:tokens"
      }
    }
  ]
}
